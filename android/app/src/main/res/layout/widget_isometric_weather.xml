<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- 1. Continuously animating 4-frame ViewFlipper for 3D Isometric Island, Water Sparkles & Gentle Weather FX -->
    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="520">

        <ImageView
            android:id="@+id/widget_frame_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="3D Isometric Weather Frame 1" />

        <ImageView
            android:id="@+id/widget_frame_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="3D Isometric Weather Frame 2" />

        <ImageView
            android:id="@+id/widget_frame_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="3D Isometric Weather Frame 3" />

        <ImageView
            android:id="@+id/widget_frame_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="3D Isometric Weather Frame 4" />
    </ViewFlipper>

    <!-- 2A. Top-Sky HUD Banner (default on Android).
         Stacked full-width rows instead of two side-by-side columns so long strings never
         run off the widget. IsometricWeatherWidgetProvider.fitTextSp() shrinks each row's
         text size to the real widget width reported by AppWidgetManager options. -->
    <LinearLayout
        android:id="@+id/widget_hud_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/hud_background"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp">

        <!-- Row 1: Weather icon + temperature (left), digital clock (center/right) & condition headline (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/hud_bar_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ 68°F (20°C)"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/hud_bar_clock_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true">

                    <TextClock
                        android:id="@+id/hud_bar_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm a"
                        android:format24Hour="HH:mm"
                        android:textColor="#E0F2FE"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:background="#38000000"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <TextView
                    android:id="@+id/hud_bar_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR"
                    android:textColor="#FFD166"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Location + feels-like -->
        <TextView
            android:id="@+id/hud_bar_condition_loc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 YORKTOWN, VA • FEELS 67°F"
            android:textColor="#D9ECFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Row 3: Humidity + wind -->
        <TextView
            android:id="@+id/hud_bar_wind_hum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="💧 64% • 💨 8 MPH NNE"
            android:textColor="#EEF6FC"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Row 4 (optional, "Show Extended HUD"): AQI / UV / moon -->
        <TextView
            android:id="@+id/hud_bar_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="AQI 24 GOOD • UV 3.2 • 🌔"
            android:textColor="#86EFAC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3. Interactive On-Widget Zoom, Horizontal Centering & Settings Control Bar (Hidden per user request for photographic diorama clean look) -->
    <LinearLayout
        android:id="@+id/widget_camera_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:background="#CC142230"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_zoom_out"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="➖"
            android:textColor="#E6F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_zoom_in"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="➕"
            android:textColor="#E6F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_pan_left"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#E6F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_cam_reset"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="🎯"
            android:textColor="#FFD166"
            android:textSize="12sp"
            android:background="@drawable/widget_btn_selector" />

        <TextView
            android:id="@+id/btn_pan_right"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#E6F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_open_config"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="⚙️"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4. Subtle Bottom-Right Theme & Location Badge + Transparent Reload/Refresh Button -->
    <LinearLayout
        android:id="@+id/widget_bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_bottom_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#B81C2C3C"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Yorktown, VA • 3D Isometric"
            android:textColor="#EEF6FC"
            android:textSize="10.5sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btn_widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#DDF0FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_selector"
            android:contentDescription="Refresh Weather and Location" />
    </LinearLayout>
</FrameLayout>
