<?xml version="1.0" encoding="utf-8"?>
<!--
  Android AppWidgetProviderInfo for OnePlus 13 (OxygenOS 15) & Android 12+
  Default 4x3 cells, fully resizable horizontally and vertically on Homescreen & Lockscreen.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="95dp"
    android:maxResizeWidth="800dp"
    android:maxResizeHeight="700dp"
    android:updatePeriodMillis="900000"
    android:initialLayout="@layout/widget_isometric_weather"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_description" />
